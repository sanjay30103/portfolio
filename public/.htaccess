# Hostinger (Apache / LiteSpeed) settings for the static Next.js export

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Correct file types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType text/vtt .vtt
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/pdf .pdf
</IfModule>

# Show the resume PDF inside the browser instead of forcing a download
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Content-Disposition "inline"
  </FilesMatch>
</IfModule>

# The social share image is generated without a file extension
<Files "opengraph-image">
  ForceType image/png
</Files>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching
<IfModule mod_headers.c>
  # Next.js build files have unique names, so they can be cached forever
  <FilesMatch "^.*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|mp4|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML should always be fresh so new deploys show up immediately
  <FilesMatch "\.(html|txt|xml|pdf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
